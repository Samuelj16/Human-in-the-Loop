# ==============================================================================
# Human in the Loop (HITL) - Environment Configuration
# ==============================================================================

# Application
APP_NAME="Human in the Loop"
ENVIRONMENT=development
CORS_ORIGINS="http://localhost:3000"

# Storage
# Default SQLite fallback for friction-free local setup without Postgres running:
DATABASE_URL="sqlite+aiosqlite:///./hitl.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/hitl"

# Redis (Optional) - If unset, background jobs execute in-process via asyncio.
# Set this when running an external worker (`arq app.worker.WorkerSettings`)
# REDIS_URL="redis://localhost:6379"

# Authentication (JWT)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Development generates an ephemeral secret when this is omitted. Production
# requires a stable value of at least 32 characters.
JWT_SECRET=""
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Model provider. Hosted APIs: "gemini", "anthropic", "openai".
# Open weights on your own hardware: "ollama", "llamacpp", "lmstudio", "vllm".
# Open weights, hosted:               "openrouter", "groq", "together", "fireworks".
# Any other OpenAI-compatible server: "open" (then set OPEN_MODEL_BASE_URL).
LLM_PROVIDER=gemini

# Google Gemini Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Anthropic Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
ANTHROPIC_ENABLE_FALLBACKS=true

# OpenAI Configuration
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"

# Open-weight models (Ollama, vLLM, OpenRouter, Groq, ...)
# Zero-cost local setup:
#   brew install ollama && ollama serve && ollama pull llama3.1:8b
#   LLM_PROVIDER=ollama
OPEN_MODEL_NAME="llama3.1:8b"
# Only for endpoints that are not a known preset.
OPEN_MODEL_BASE_URL=""
# Local servers ignore this; hosted ones (OpenRouter, Groq, ...) require it.
OPEN_MODEL_API_KEY=""
# USD per 1M tokens. 0 is correct for a model on your own hardware - the
# approval gate then shows $0.00 instead of guessing a price.
OPEN_MODEL_PRICE_INPUT=0.0
OPEN_MODEL_PRICE_OUTPUT=0.0

# Search (Tavily API or Stub fallback)
# Leave empty to use the built-in deterministic Stub search for offline development
TAVILY_API_KEY=""

# Spend Caps & Quotas (Safety bounds per research task)
MAX_TOOL_ITERATIONS=12
MAX_SEARCHES_PER_TASK=8
MAX_OUTPUT_TOKENS_PER_TASK=60000
MAX_TASKS_PER_USER_PER_DAY=25
